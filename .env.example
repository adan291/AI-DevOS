# Copia este fichero a .env y rellena los valores. No subas .env al repositorio.

# --- Modo solo-API (npm run start:api): mínimo necesario -------------------
# Puerto e interfaz de la REST API (/api/status, /api/agents, /api/review, /api/ask)
WEBHOOK_PORT=3001
API_HOST=127.0.0.1
# Token para "Authorization: Bearer <WEBHOOK_API_KEY>". Obligatorio si API_HOST no es loopback.
WEBHOOK_API_KEY=

# Proveedor LLM: groq | anthropic | openai | ollama (basta con configurar uno)
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=
# Selección de modelo por complejidad de la tarea (false = siempre LLM_PROVIDER)
MODEL_ROUTER_ENABLED=false

# Límites de /api/review y del resto de endpoints (opcionales)
# REVIEW_MAX_BODY_BYTES=2097152
# API_MAX_BODY_BYTES=262144
# REVIEW_MAX_CHARS_PER_BATCH=24000
# REVIEW_CONCURRENCY=2

# --- Modo completo (npm start): además de lo anterior ----------------------
DISCORD_TOKEN=
DATABASE_URL=postgres://user:password@localhost:5432/discordia
REDIS_URL=redis://localhost:6379
# Adaptadores: discord,slack,telegram,webhook
CHAT_ADAPTERS=discord
# Canales de Discord en los que responde el bot (separados por comas; vacío = todos)
DISCORD_ALLOWED_CHANNEL_IDS=
# Puerto del adaptador webhook; debe ser distinto de WEBHOOK_PORT si CHAT_ADAPTERS incluye webhook
# WEBHOOK_ADAPTER_PORT=3002

# VCS: github,gitlab
VCS_ADAPTERS=github
GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com

# Slack / Telegram (opcionales)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# TELEGRAM_BOT_TOKEN=
