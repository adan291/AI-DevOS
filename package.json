{
  "name": "ai-devos",
  "version": "1.0.0",
  "description": "AI DevOS - Multi-agent development operating system built on Discord",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prestart:api": "npm run build",
    "start:api": "node dist/api-only.js",
    "dev:api": "tsx watch src/api-only.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "discord",
    "ai",
    "multi-agent",
    "devops",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "openai": "^6.33.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
